# ==============================================================================
# Shariah Trading Agent - Environment Variables Configuration
# ==============================================================================
# In CapRover: Set these in "App Configs" > "Environmental Variables".
# Locally: Copy this file to .env and fill in your keys.

# ------------------------------------------------------------------------------
# 1. AI Trading Brain Settings (Zero config.yaml edits required!)
# ------------------------------------------------------------------------------
# Provider to use: claude | deepseek | openai | gemini
AI_PROVIDER=claude

# Model ID override (optional - if omitted, optimal defaults are used automatically):
#   For claude:   claude-3-5-sonnet-latest
#   For deepseek: deepseek-reasoner (or deepseek-chat)
#   For openai:   o3-mini (or gpt-4o)
#   For gemini:   gemini-2.5-flash (or gemini-1.5-pro)
# AI_MODEL=claude-3-5-sonnet-latest

# API Keys (You can store all of them; the agent uses the one for AI_PROVIDER)
ANTHROPIC_API_KEY=sk-ant-api03-...
DEEPSEEK_API_KEY=sk-...
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=AIzaSy...

# Minimum conviction score required to trigger a trade (1.0 - 10.0 scale, default 8.0)
AI_MIN_CONFIDENCE=8.0

# Capital allocation & position limits for swing trades (e.g. Rs 5,000 test)
AI_MAX_ALLOCATION=5000.0
AI_MAX_POSITIONS=1

# ------------------------------------------------------------------------------
# 2. Groww Broker API (Live CNC Delivery Execution)
# ------------------------------------------------------------------------------
GROWW_API_KEY=eyJhbGciOi...
GROWW_TOTP_SECRET=UCHDT53IFLW5RM22EURB4THRHV74LUCF

# ------------------------------------------------------------------------------
# 3. Web Dashboard Security & Process Roles
# ------------------------------------------------------------------------------
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=your_secure_password
DASHBOARD_ALLOW_HOST=trading.lifemint.net
AGENT_ROLE=dashboard
